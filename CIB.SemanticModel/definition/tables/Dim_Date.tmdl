	partition Dim_Date = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\diaa\Desktop\CIB\CIB_Q1_2026_Financial_Data.xlsx"), null, true),
				    Dim_Date_Sheet = Source{[Item="Dim_Date",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Dim_Date_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Date", Int64.Type}, {"Year", Int64.Type}, {"Quarter", Int64.Type}, {"Month", Int64.Type}, {"Period_Label", type date}, {"Date_Role", type text}}),
				    Added_Date_Value = Table.AddColumn(#"Changed Type", "Date_Value", each Date.AddDays(#date(1899, 12, 30), [Date]), type date),
				    Added_Period_Label_Correct = Table.AddColumn(Added_Date_Value, "Period_Label_Correct", each Date.ToText([Date_Value], "dd-MMM-yyyy", "en-US"), type text)
				in
				    Added_Period_Label_Correct

	annotation PBI_ResultType = Table

