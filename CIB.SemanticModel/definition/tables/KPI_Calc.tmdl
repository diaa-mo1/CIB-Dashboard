	partition KPI_Calc = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\diaa\Desktop\CIB\CIB_Q1_2026_Financial_Data.xlsx"), null, true),
				    KPI_Calc_Sheet = Source{[Item="KPI_Calc",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(KPI_Calc_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Calculated KPIs (derived from reported data sheets - NOT reported by the bank)", type text}, {"Column2", type any}, {"Column3", type text}, {"Column4", type any}, {"Column5", type any}, {"Column6", type text}, {"Column7", type text}, {"Column8", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

